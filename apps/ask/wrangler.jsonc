{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ask-megabyte-space",
  "account_id": "84fa0d1b16ff8086dd958c468ce7fd59",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "questionl.ink", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker runs first for EVERY request so it can (a) render dynamic per-room OG
    // cards at /og/:slug and (b) inject per-room OG/meta into the SPA shell for room
    // pages via HTMLRewriter. Static assets still resolve through notFound → ASSETS,
    // so correctness holds for every path (the slug branch guards against asset paths).
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    "SERVICE_ORIGIN": "https://questionl.ink",
    "SHARED_AUTH_ISSUER": "https://projectsites.dev",
    "BILLING_GRACE_DAYS": "7",
    "ENRICHMENT_ENABLED": "1",
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 15, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ask-registry",
      "database_id": "969a3deb-c32b-45d2-b9e6-6682953e1d41",
      "migrations_dir": "migrations",
    },
  ],
}
