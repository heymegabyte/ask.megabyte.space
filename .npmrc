# The e2e/ suite lives at the repo root (outside any workspace package), so its test
# deps must be hoisted into the root node_modules for Playwright to resolve them when
# it loads the spec files. Without this, `pnpm --filter @ask/app test:e2e` fails with
# "Cannot find package '@playwright/test'" for every root-level spec.
public-hoist-pattern[]=@playwright/*
public-hoist-pattern[]=@axe-core/*
